#!/usr/bin/env python3
"""
ZeroDrive MCP Server (Model Context Protocol)
Standard JSON-RPC 2.0 STDIO server providing instant ZeroDrive cloud vault
access (read, write, list, search, size, share) to AI agents (Claude Desktop,
Cursor, Codex, Antigravity, OpenDevin, LibreChat).
"""

import sys
import os
import json
import subprocess
import shutil

ZD_BIN = os.path.expanduser("~/.local/bin/zd")
if not os.path.exists(ZD_BIN):
    ZD_BIN = shutil.which("zd") or shutil.which("zerodrive") or "/usr/local/bin/zd"

def run_zd(*args):
    cmd = [ZD_BIN, "--no-color"] + list(args)
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()

TOOLS = [
    {
        "name": "zd_list",
        "description": "List files and subfolders in a ZeroDrive vault directory with sizes and dates.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Vault directory path (e.g. '', 'MAIN', 'Course', '_BUSINESS').",
                    "default": ""
                },
                "recursive": {
                    "type": "boolean",
                    "description": "List subdirectories recursively.",
                    "default": False
                }
            }
        }
    },
    {
        "name": "zd_read",
        "description": "Read the text contents of a file in the ZeroDrive vault. Supports line slicing to save context tokens.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Vault file path (e.g. 'ROUTER.md', 'MAIN/AGENTS.md')."
                },
                "head": {
                    "type": "integer",
                    "description": "Read only the first N lines."
                },
                "tail": {
                    "type": "integer",
                    "description": "Read only the last N lines."
                },
                "lines": {
                    "type": "string",
                    "description": "Read specific line range (e.g. '1-50', '100-150')."
                }
            },
            "required": ["path"]
        }
    },
    {
        "name": "zd_write",
        "description": "Write or overwrite a text file directly into the ZeroDrive cloud vault.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Target vault path (e.g. 'MAIN/notes.md', 'Course/summary.txt')."
                },
                "content": {
                    "type": "string",
                    "description": "Text content to write."
                }
            },
            "required": ["path", "content"]
        }
    },
    {
        "name": "zd_search",
        "description": "Search for files and directories across the ZeroDrive vault by pattern/glob.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "pattern": {
                    "type": "string",
                    "description": "Search pattern (e.g. '*.md', '*Dan Kennedy*', '*.mp4')."
                },
                "path": {
                    "type": "string",
                    "description": "Directory to search within (defaults to whole vault).",
                    "default": ""
                }
            },
            "required": ["pattern"]
        }
    },
    {
        "name": "zd_size",
        "description": "Get sub-second file count and total size for any folder using Cloudflare R2 metadata.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Vault folder path (e.g. 'Course', 'MAIN/LEGENDS').",
                    "default": ""
                }
            }
        }
    },
    {
        "name": "zd_share",
        "description": "Generate a secure pre-signed HTTPS download link for any file in the vault.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "path": {
                    "type": "string",
                    "description": "Vault file path (e.g. 'Course/video.mp4')."
                },
                "hours": {
                    "type": "integer",
                    "description": "Link expiration in hours (default 24).",
                    "default": 24
                }
            },
            "required": ["path"]
        }
    }
]

def handle_call_tool(name, args):
    if name == "zd_list":
        path = args.get("path", "")
        cmd = ["ls", path, "--json"]
        if args.get("recursive"):
            cmd.append("-R")
        code, out, err = run_zd(*cmd)
        if code != 0:
            return {"isError": True, "content": [{"type": "text", "text": f"Error: {err or out}"}]}
        return {"content": [{"type": "text", "text": out}]}

    elif name == "zd_read":
        path = args.get("path", "")
        cmd = ["cat", path]
        if "head" in args:
            cmd.extend(["--head", str(args["head"])])
        elif "tail" in args:
            cmd.extend(["--tail", str(args["tail"])])
        elif "lines" in args:
            cmd.extend(["--lines", str(args["lines"])])
        code, out, err = run_zd(*cmd)
        if code != 0:
            return {"isError": True, "content": [{"type": "text", "text": f"Error: {err or out}"}]}
        return {"content": [{"type": "text", "text": out}]}

    elif name == "zd_write":
        path = args.get("path", "")
        content = args.get("content", "")
        import tempfile
        with tempfile.NamedTemporaryFile("w", delete=False) as tmp:
            tmp.write(content)
            tmp_path = tmp.name
        try:
            code, out, err = run_zd("cp", tmp_path, path)
            if code != 0:
                return {"isError": True, "content": [{"type": "text", "text": f"Error writing file: {err or out}"}]}
            return {"content": [{"type": "text", "text": f"Successfully wrote {len(content)} bytes to {path} in ZeroDrive vault."}]}
        finally:
            if os.path.exists(tmp_path):
                os.unlink(tmp_path)

    elif name == "zd_search":
        pattern = args.get("pattern", "")
        path = args.get("path", "")
        cmd = ["find", pattern]
        if path:
            cmd.extend(["--path", path])
        code, out, err = run_zd(*cmd)
        if code != 0:
            return {"isError": True, "content": [{"type": "text", "text": f"Error: {err or out}"}]}
        return {"content": [{"type": "text", "text": out}]}

    elif name == "zd_size":
        path = args.get("path", "")
        code, out, err = run_zd("size", path, "--json")
        if code != 0:
            return {"isError": True, "content": [{"type": "text", "text": f"Error: {err or out}"}]}
        return {"content": [{"type": "text", "text": out}]}

    elif name == "zd_share":
        path = args.get("path", "")
        hours = args.get("hours", 24)
        code, out, err = run_zd("share", path, "--hours", str(hours))
        if code != 0:
            return {"isError": True, "content": [{"type": "text", "text": f"Error: {err or out}"}]}
        return {"content": [{"type": "text", "text": out}]}

    else:
        return {"isError": True, "content": [{"type": "text", "text": f"Unknown tool: {name}"}]}

def main():
    while True:
        try:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue
            req = json.loads(line)
        except (json.JSONDecodeError, Exception):
            continue

        req_id = req.get("id")
        method = req.get("method")
        params = req.get("params", {})

        if method == "initialize":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "protocolVersion": "2024-11-05",
                    "capabilities": {
                        "tools": {}
                    },
                    "serverInfo": {
                        "name": "zerodrive-mcp",
                        "version": "1.0.0"
                    }
                }
            }
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()

        elif method == "notifications/initialized":
            pass

        elif method == "tools/list":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {
                    "tools": TOOLS
                }
            }
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()

        elif method == "tools/call":
            name = params.get("name")
            args = params.get("arguments", {})
            res = handle_call_tool(name, args)
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": res
            }
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()

        elif method == "ping":
            resp = {
                "jsonrpc": "2.0",
                "id": req_id,
                "result": {}
            }
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()

        else:
            if req_id is not None:
                resp = {
                    "jsonrpc": "2.0",
                    "id": req_id,
                    "error": {
                        "code": -32601,
                        "message": f"Method not found: {method}"
                    }
                }
                sys.stdout.write(json.dumps(resp) + "\n")
                sys.stdout.flush()

if __name__ == "__main__":
    main()
