#!/usr/bin/env python3
"""
ZeroDrive CLI (zd / zerodrive)
High-performance command-line interface for ZeroDrive cloud vaults.
Blends Cloudflare R2 object storage with multi-stream rclone engine
and loopback NFS daemon controls.
"""

import os
import sys
import json
import time
import shutil
import urllib.request
import urllib.error
import subprocess
import argparse
import collections
from pathlib import Path

VERSION = "1.0.1"
DEFAULT_BUCKET_PREFIX = "zerodrive-vault-prod/usr_andrew_8bc7fb477f"

# ZeroDrive Configuration & State (Primary: ~/.config/zerodrive/, Fallback: ~/.config/rclone/)
CONFIG_DIR = os.path.expanduser("~/.config/zerodrive")
LEGACY_DIR = os.path.expanduser("~/.config/rclone")

def get_config_path(filename, default_legacy_name=None):
    p = os.path.join(CONFIG_DIR, filename)
    if os.path.exists(p):
        return p
    legacy_file = default_legacy_name or filename
    lp = os.path.join(LEGACY_DIR, legacy_file)
    if os.path.exists(lp):
        return lp
    return p

SETTINGS_PATH = get_config_path("zerodrive-vault.json")
CONFIG_FILE = get_config_path("vault.conf", "rclone.conf")
SYMLINKS_PATH = get_config_path("zerodrive-symlinks.json")
LOCAL_TELEMETRY = get_config_path("migration-telemetry.json")
REMOTE_TELEMETRY = get_config_path("remote-migration-telemetry.json")
MOUNT_DIR = os.path.expanduser("~/ZeroDrive/My Drive")
RC_URL = "http://127.0.0.1:55729"

# Locate ZeroDrive Storage Engine core binary
STORAGE_ENGINE_BIN = "/Applications/ZeroDrive.app/Contents/Resources/zerodrive-engine"
if not os.path.exists(STORAGE_ENGINE_BIN):
    STORAGE_ENGINE_BIN = "/Applications/ZeroDrive.app/Contents/Resources/rclone"
if not os.path.exists(STORAGE_ENGINE_BIN):
    STORAGE_ENGINE_BIN = shutil.which("zerodrive-engine") or shutil.which("rclone") or "/opt/homebrew/bin/rclone"

# ANSI Colors
COLOR_RESET = "\033[0m"
COLOR_BOLD = "\033[1m"
COLOR_DIM = "\033[2m"
COLOR_CYAN = "\033[36m"
COLOR_GREEN = "\033[32m"
COLOR_YELLOW = "\033[33m"
COLOR_BLUE = "\033[34m"
COLOR_MAGENTA = "\033[35m"
COLOR_RED = "\033[31m"

def is_color_enabled():
    return sys.stdout.isatty() and "--no-color" not in sys.argv

def c(text, color):
    return f"{color}{text}{COLOR_RESET}" if is_color_enabled() else text

def format_bytes(bytes_count):
    if bytes_count is None or bytes_count < 0:
        return "0 B"
    for unit in ["B", "KB", "MB", "GB", "TB", "PB"]:
        if bytes_count < 1024.0 or unit == "PB":
            return f"{bytes_count:.2f} {unit}" if unit in ["GB", "TB", "PB"] else f"{bytes_count:.1f} {unit}"
        bytes_count /= 1024.0
    return f"{bytes_count:.1f} B"

def load_vault_prefix():
    prefix = DEFAULT_BUCKET_PREFIX
    if os.path.exists(SETTINGS_PATH):
        try:
            with open(SETTINGS_PATH, "r") as f:
                data = json.load(f)
                bp = data.get("bucketAndPrefix", "").strip("/")
                if bp and bp != "zerodrive-vault-prod":
                    prefix = bp
        except Exception:
            pass
    return prefix

def get_vault_remote_base():
    return f"primary_vault:{load_vault_prefix()}"

# --- PATH CLASSIFICATION & RESOLUTION ---

class EndpointType:
    LOCAL = "LOCAL"
    REMOTE = "REMOTE"

def classify_endpoint(raw_path, default_to_vault=False):
    """
    Explicitly categorizes path as LOCAL or REMOTE (vault).
    Returns (endpoint_type, resolved_path, is_dir_hint).
    """
    if not raw_path or raw_path == "/":
        return (EndpointType.REMOTE, get_vault_remote_base(), True)

    is_dir_hint = raw_path.endswith("/") or raw_path.endswith(os.sep)

    # 1. Explicit remote protocol or prefix
    if ":" in raw_path and not raw_path.startswith("/") and not raw_path.startswith("~"):
        if raw_path.startswith("vault:") or raw_path.startswith("zd://"):
            clean = raw_path.split(":", 1)[1].lstrip("/")
            resolved = f"{get_vault_remote_base()}/{clean}" if clean else get_vault_remote_base()
            return (EndpointType.REMOTE, resolved, is_dir_hint)
        # Standard rclone remote (e.g. primary_vault:... or other)
        return (EndpointType.REMOTE, raw_path, is_dir_hint)

    # Helper to check if a path is strictly inside or equal to the mount root
    mount_root = os.path.abspath(MOUNT_DIR)
    def is_inside_mount(p):
        try:
            rel = os.path.relpath(p, mount_root)
            return rel == "." or (not rel.startswith("..") and not os.path.isabs(rel))
        except ValueError:
            return False

    # 2. Explicit home directory or relative directory syntax
    if raw_path.startswith("~") or raw_path.startswith("./") or raw_path.startswith("../"):
        expanded = os.path.abspath(os.path.expanduser(raw_path))
        if is_inside_mount(expanded):
            rel = os.path.relpath(expanded, mount_root)
            if rel == ".":
                return (EndpointType.REMOTE, get_vault_remote_base(), True)
            resolved = f"{get_vault_remote_base()}/{rel}"
            return (EndpointType.REMOTE, resolved, is_dir_hint or os.path.isdir(expanded))
        return (EndpointType.LOCAL, expanded, is_dir_hint or os.path.isdir(expanded))

    # 3. Absolute path on local filesystem
    if raw_path.startswith("/"):
        # Check if it physically exists on local disk or is in standard macOS root folders
        is_known_local_root = any(raw_path.startswith(p) for p in [
            "/Users", "/Volumes", "/tmp", "/private", "/Applications", "/Library", "/System", "/opt", "/usr", "/var"
        ])
        if is_known_local_root or os.path.exists(raw_path):
            expanded = os.path.abspath(raw_path)
            if is_inside_mount(expanded):
                rel = os.path.relpath(expanded, mount_root)
                if rel == ".":
                    return (EndpointType.REMOTE, get_vault_remote_base(), True)
                resolved = f"{get_vault_remote_base()}/{rel}"
                return (EndpointType.REMOTE, resolved, is_dir_hint or os.path.isdir(expanded))
            return (EndpointType.LOCAL, expanded, is_dir_hint or os.path.isdir(expanded))

        # Absolute slash not in known local system -> Cloud Vault root reference (e.g. /Course)
        clean = raw_path.lstrip("/")
        resolved = f"{get_vault_remote_base()}/{clean}" if clean else get_vault_remote_base()
        return (EndpointType.REMOTE, resolved, is_dir_hint)

    # 4. Bare relative path
    if default_to_vault:
        resolved = f"{get_vault_remote_base()}/{raw_path}"
        return (EndpointType.REMOTE, resolved, is_dir_hint)

    if os.path.exists(raw_path):
        expanded = os.path.abspath(raw_path)
        if is_inside_mount(expanded):
            rel = os.path.relpath(expanded, mount_root)
            resolved = f"{get_vault_remote_base()}/{rel}" if rel != "." else get_vault_remote_base()
            return (EndpointType.REMOTE, resolved, is_dir_hint or os.path.isdir(expanded))
        return (EndpointType.LOCAL, expanded, is_dir_hint or os.path.isdir(expanded))

    # Doesn't exist locally -> assume relative path in Cloud Vault
    resolved = f"{get_vault_remote_base()}/{raw_path}"
    return (EndpointType.REMOTE, resolved, is_dir_hint)

def resolve_vault_path(arg):
    """Shorthand for query commands (ls, size, cat, find) that always target the vault."""
    _, path, _ = classify_endpoint(arg, default_to_vault=True)
    return path

# --- RC & RCLONE HELPERS ---

def run_rc_post(endpoint, payload=None, timeout=3.0):
    url = f"{RC_URL}/{endpoint.lstrip('/')}"
    data = json.dumps(payload or {}).encode("utf-8") if payload is not None else b"{}"
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            content = resp.read().decode("utf-8")
            if not content.strip():
                return {}
            return json.loads(content)
    except urllib.error.HTTPError as e:
        try:
            err_body = e.read().decode("utf-8")
            return json.loads(err_body)
        except Exception:
            return {"error": f"HTTP {e.code}: {e.reason}"}
    except Exception as e:
        return None

def exec_engine(args, capture_output=True, text=True):
    cmd = [STORAGE_ENGINE_BIN] + args + [f"--config={CONFIG_FILE}"]
    if capture_output:
        return subprocess.run(cmd, capture_output=True, text=text)
    return subprocess.run(cmd)

exec_rclone = exec_engine

# --- COMMAND IMPLEMENTATIONS ---

def cmd_status(args):
    """zd status: Show live mount status, SSD free space, VFS cache & sync queues"""
    usage = shutil.disk_usage("/")
    free_gb = usage.free / (1024 ** 3)
    total_gb = usage.total / (1024 ** 3)

    # Check mount
    mount_proc = subprocess.run(["mount"], capture_output=True, text=True)
    is_mounted = ".zerodrive-mount" in mount_proc.stdout or "ZeroDrive" in mount_proc.stdout

    # Daemon RC stats
    rc_stats = run_rc_post("core/stats", timeout=0.8)
    vfs_stats = run_rc_post("vfs/stats", timeout=0.8)
    daemon_online = rc_stats is not None

    cache_bytes = 0
    cache_files = 0
    uploads_in_progress = 0
    uploads_queued = 0
    errored_files = 0

    has_valid_vfs = isinstance(vfs_stats, dict) and "diskCache" in vfs_stats
    if has_valid_vfs:
        dc = vfs_stats["diskCache"]
        cache_bytes = dc.get("bytesUsed", 0)
        cache_files = dc.get("files", 0)
        uploads_in_progress = dc.get("uploadsInProgress", 0)
        uploads_queued = dc.get("uploadsQueued", 0)
        errored_files = dc.get("erroredFiles", 0)

    # Sync state determination
    if not daemon_online:
        vfs_sync_state = "Unknown (Daemon offline)"
    elif not has_valid_vfs:
        vfs_sync_state = "Unknown (VFS queue statistics unavailable)"
    elif errored_files > 0:
        vfs_sync_state = f"Errors ({errored_files} files failed upload)"
    elif uploads_in_progress > 0 or uploads_queued > 0:
        vfs_sync_state = f"Uploading ({uploads_in_progress} active, {uploads_queued} queued in VFS cache)"
    else:
        vfs_sync_state = "Idle (0 pending VFS uploads)"

    # Symlinks count
    symlink_count = 0
    if os.path.exists(SYMLINKS_PATH):
        try:
            with open(SYMLINKS_PATH, "r") as f:
                symlink_count = len(json.load(f))
        except Exception:
            pass

    # Active stream telemetry
    active_stream = None
    for tpath in [LOCAL_TELEMETRY, REMOTE_TELEMETRY]:
        if os.path.exists(tpath):
            try:
                with open(tpath, "r") as f:
                    tdata = json.load(f)
                    if tdata.get("isRunning"):
                        active_stream = tdata
                        break
            except Exception:
                pass

    if args.json:
        payload = {
            "mounted": is_mounted,
            "mountPath": MOUNT_DIR,
            "daemonOnline": daemon_online,
            "macSsdFreeGB": round(free_gb, 2),
            "macSsdTotalGB": round(total_gb, 2),
            "vfsCacheBytes": cache_bytes,
            "vfsCacheFiles": cache_files,
            "vfsSyncState": vfs_sync_state,
            "uploadsInProgress": uploads_in_progress,
            "uploadsQueued": uploads_queued,
            "erroredFiles": errored_files,
            "activeSymlinks": symlink_count,
            "activeMigration": active_stream,
            "vaultPrefix": load_vault_prefix()
        }
        print(json.dumps(payload, indent=2))
        return 0

    print(c("\n⚡ ZeroDrive System Status", COLOR_BOLD + COLOR_CYAN))
    print(c("═" * 54, COLOR_DIM))
    mount_str = c("✓ Connected & Mounted", COLOR_GREEN) if is_mounted else c("✗ Not Mounted", COLOR_RED)
    print(f"  {c('Finder Mount:', COLOR_BOLD):<24} {mount_str}")
    print(f"  {c('Mount Path:', COLOR_BOLD):<24} {MOUNT_DIR}")
    print(f"  {c('Mac SSD Free:', COLOR_BOLD):<24} {c(f'{free_gb:.1f} GiB available', COLOR_GREEN)} ({total_gb:.0f} GB total)")

    if daemon_online:
        print(f"  {c('Local VFS Cache:', COLOR_BOLD):<24} {format_bytes(cache_bytes)} ({cache_files:,} cached files)")
        sync_color = COLOR_GREEN if "Idle" in vfs_sync_state else (COLOR_RED if "Errors" in vfs_sync_state else COLOR_YELLOW)
        print(f"  {c('VFS Sync Queue:', COLOR_BOLD):<24} {c(vfs_sync_state, sync_color)}")
    else:
        print(f"  {c('VFS Sync Queue:', COLOR_BOLD):<24} {c('Unknown (Mount daemon not reachable on 127.0.0.1:55729)', COLOR_YELLOW)}")

    print(f"  {c('Active Symlinks:', COLOR_BOLD):<24} {symlink_count} local folder shortcuts active")
    print(f"  {c('Vault Prefix:', COLOR_BOLD):<24} {load_vault_prefix()}")

    if active_stream:
        print(c("\n  Active Bulk Migration Stream:", COLOR_YELLOW))
        print(f"    Task:      {active_stream.get('spaceName')}")
        print(f"    Progress:  {active_stream.get('percent', 0)}% @ {active_stream.get('speedMBps', 0)} MB/s")
        print(f"    Status:    {active_stream.get('statusMessage')}")
    else:
        print(f"  {c('Bulk Migration:', COLOR_BOLD):<24} {c('None active', COLOR_DIM)}")

    print(c("═" * 54, COLOR_DIM) + "\n")
    return 0

def cmd_ls(args):
    """zd ls [path]: Directory listing with fast-list and explicit recursion support"""
    target = resolve_vault_path(args.path)

    if args.json:
        cmd_args = ["lsjson", target, "--fast-list"]
        if args.recursive:
            cmd_args.append("-R")
        else:
            cmd_args.extend(["--max-depth", "1"])
        res = exec_rclone(cmd_args)
        if res.returncode != 0:
            print(json.dumps({"error": res.stderr.strip()}), file=sys.stderr)
            return res.returncode
        print(res.stdout)
        return 0

    # Human-formatted terminal output
    cmd_args = ["lsf", target, "--fast-list", "--format", "pst"]
    if args.recursive:
        cmd_args.append("-R")
    else:
        cmd_args.extend(["--max-depth", "1"])

    res = exec_rclone(cmd_args)
    if res.returncode != 0:
        print(c(f"Error listing {target}: {res.stderr.strip()}", COLOR_RED), file=sys.stderr)
        return res.returncode

    lines = res.stdout.strip().splitlines()
    if not lines or (len(lines) == 1 and not lines[0]):
        print(c("(directory is empty)", COLOR_DIM))
        return 0

    display_name = target.replace(get_vault_remote_base(), "ZeroDrive: /")
    print(c(f"\n📂 {display_name}", COLOR_BOLD + COLOR_CYAN))
    print(c("─" * 60, COLOR_DIM))

    dirs = []
    files = []
    for line in lines:
        parts = line.rsplit(";", 2)
        if len(parts) < 3:
            continue
        name = parts[0]
        size = int(parts[1]) if parts[1] != "-1" else None
        mod = parts[2]

        if name.endswith("/"):
            dirs.append((name, mod))
        else:
            files.append((name, size, mod))

    for d, mod in sorted(dirs):
        print(f"  {c(d, COLOR_BLUE + COLOR_BOLD):<36} {c('DIR', COLOR_DIM):<10} {c(mod[:16], COLOR_DIM)}")

    for f, size, mod in sorted(files):
        sz_str = format_bytes(size) if size is not None else ""
        print(f"  {f:<36} {c(sz_str, COLOR_GREEN):<10} {c(mod[:16], COLOR_DIM)}")

    print(c("─" * 60, COLOR_DIM))
    print(c(f"  Total: {len(dirs)} folders, {len(files)} files\n", COLOR_DIM))
    return 0

def cmd_tree(args):
    """zd tree [path] [--depth N]: Visual tree of cloud hierarchy"""
    target = resolve_vault_path(args.path)
    cmd_args = ["tree", target, f"--level={args.depth}", "--fast-list"]
    if args.dirs_only:
        cmd_args.append("--dirs-only")

    res = exec_rclone(cmd_args)
    if res.returncode != 0:
        print(c(f"Error generating tree for {target}: {res.stderr.strip()}", COLOR_RED), file=sys.stderr)
        return res.returncode

    print(res.stdout)
    return 0

def cmd_size(args):
    """zd size [path]: Query cloud metadata size and file count"""
    target = resolve_vault_path(args.path)
    start_time = time.time()
    res = exec_rclone(["size", target, "--fast-list", "--json"])
    elapsed = time.time() - start_time

    if res.returncode != 0:
        print(c(f"Error calculating size for {target}: {res.stderr.strip()}", COLOR_RED), file=sys.stderr)
        return res.returncode

    try:
        data = json.loads(res.stdout)
        total_files = data.get("count", 0)
        total_bytes = data.get("bytes", 0)
    except Exception as e:
        print(c(f"Failed to parse size response: {e}\n{res.stdout}", COLOR_RED), file=sys.stderr)
        return 1

    display_target = target.replace(get_vault_remote_base(), "").strip("/") or "(Vault Root)"

    if args.json:
        print(json.dumps({
            "target": display_target,
            "remote": target,
            "count": total_files,
            "bytes": total_bytes,
            "humanSize": format_bytes(total_bytes),
            "durationSeconds": round(elapsed, 2)
        }, indent=2))
        return 0

    print(c(f"\n📊 ZeroDrive Vault Size", COLOR_BOLD + COLOR_CYAN))
    print(c("═" * 48, COLOR_DIM))
    print(f"  {c('Folder/Path:', COLOR_BOLD):<18} {display_target}")
    print(f"  {c('File Count:', COLOR_BOLD):<18} {c(f'{total_files:,} files', COLOR_BOLD)}")
    print(f"  {c('Total Size:', COLOR_BOLD):<18} {c(format_bytes(total_bytes), COLOR_GREEN + COLOR_BOLD)} ({total_bytes:,} bytes)")
    print(f"  {c('Query Time:', COLOR_BOLD):<18} {elapsed:.2f}s (Cloudflare R2 metadata API)")
    print(c("═" * 48, COLOR_DIM) + "\n")
    return 0

def cmd_cat(args):
    """
    zd cat <path>: Read file contents. Streams directly from cloud with line slicing
    or byte range support. Terminating streams cleanly without hanging.
    """
    target = resolve_vault_path(args.path)

    # Parse line slicing range
    start_line, end_line = None, None
    if args.lines:
        try:
            if "-" in args.lines:
                p = args.lines.split("-")
                start_line = int(p[0]) if p[0] else 1
                end_line = int(p[1]) if p[1] else None
            else:
                start_line = int(args.lines)
                end_line = int(args.lines)
        except ValueError:
            print(c(f"Error: Invalid --lines format '{args.lines}'. Use 'N-M' or 'N'.", COLOR_RED), file=sys.stderr)
            return 1

    # Validate numeric options
    if args.head is not None and args.head <= 0:
        print(c(f"Error: --head must be a positive integer, got {args.head}.", COLOR_RED), file=sys.stderr)
        return 2
    if args.tail is not None and args.tail <= 0:
        print(c(f"Error: --tail must be a positive integer, got {args.tail}.", COLOR_RED), file=sys.stderr)
        return 2

    # Check byte-range request
    cmd_args = ["cat", target]
    is_binary = bool(args.bytes)
    if args.bytes:
        try:
            if "-" in args.bytes:
                b_parts = args.bytes.split("-")
                b_offset = int(b_parts[0]) if b_parts[0] else 0
                b_end = int(b_parts[1]) if b_parts[1] else None
                b_count = (b_end - b_offset + 1) if b_end is not None else None
            else:
                b_offset = int(args.bytes)
                b_count = 1
            cmd_args.extend([f"--offset={b_offset}"])
            if b_count is not None:
                cmd_args.extend([f"--count={b_count}"])
        except ValueError:
            print(c(f"Error: Invalid --bytes format '{args.bytes}'. Use 'OFFSET-END'.", COLOR_RED), file=sys.stderr)
            return 2

    # Launch streaming child process (binary for --bytes, text for line slicing)
    proc = subprocess.Popen(
        [STORAGE_ENGINE_BIN] + cmd_args + [f"--config={CONFIG_FILE}"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=not is_binary,
        bufsize=-1 if is_binary else 1
    )

    try:
        if is_binary:
            chunk = proc.stdout.read()
            if chunk:
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
                return 0
            chk = exec_rclone(["lsf", target, "--files-only"])
            if chk.returncode != 0 or not chk.stdout.strip():
                print(c(f"Error: File '{args.path}' does not exist in ZeroDrive vault.", COLOR_RED), file=sys.stderr)
                return 1
            return 0

        # Case A: Tail N lines (bounded memory via deque)
        if args.tail is not None:
            tail_queue = collections.deque(maxlen=args.tail)
            for line in proc.stdout:
                tail_queue.append(line)
            if not tail_queue:
                chk = exec_rclone(["lsf", target, "--files-only"])
                if chk.returncode != 0 or not chk.stdout.strip():
                    print(c(f"Error: File '{args.path}' does not exist in ZeroDrive vault.", COLOR_RED), file=sys.stderr)
                    return 1
            for line in tail_queue:
                sys.stdout.write(line)
            sys.stdout.flush()
            return 0

        # Case B: Sequential streaming with optional line bounds or head count
        line_num = 1
        lines_emitted = 0
        for line in proc.stdout:
            if args.head is not None and line_num > args.head:
                break
            if start_line is not None and line_num < start_line:
                line_num += 1
                continue
            if end_line is not None and line_num > end_line:
                break

            sys.stdout.write(line)
            line_num += 1
            lines_emitted += 1
        sys.stdout.flush()

        # If zero lines were emitted, check if file exists
        if lines_emitted == 0:
            chk = exec_rclone(["lsf", target, "--files-only"])
            if chk.returncode != 0 or not chk.stdout.strip():
                print(c(f"Error: File '{args.path}' does not exist in ZeroDrive vault.", COLOR_RED), file=sys.stderr)
                return 1

    finally:
        # Crucial fix for pipe hangs: close stdout pipe and terminate child immediately
        try:
            if proc.stdout:
                proc.stdout.close()
        except Exception:
            pass

        if proc.poll() is None:
            try:
                proc.terminate()
                proc.wait(timeout=1.0)
            except (subprocess.TimeoutExpired, Exception):
                try:
                    proc.kill()
                    proc.wait()
                except Exception:
                    pass

    # Propagate failure code if rclone failed
    if proc.poll() is not None and proc.returncode != 0:
        # If we didn't deliberately terminate it early for --head/--lines
        if args.head is None and args.lines is None:
            err = proc.stderr.read() if proc.stderr else ""
            if err:
                print(c(f"Error reading {target}: {err.strip()}", COLOR_RED), file=sys.stderr)
            return proc.returncode

    return 0

def cmd_find(args):
    """zd find <pattern> [path]: Wildcard search using server-side filtering"""
    target = resolve_vault_path(args.path)
    pattern = args.pattern
    include_pat = pattern if (pattern.startswith("*") or "?" in pattern) else f"*{pattern}*"

    cmd_args = ["lsf", target, "-R", "--fast-list", "--files-only", f"--include={include_pat}"]
    res = exec_rclone(cmd_args)
    if res.returncode != 0:
        print(c(f"Error searching in {target}: {res.stderr.strip()}", COLOR_RED), file=sys.stderr)
        return res.returncode

    matches = [f for f in res.stdout.strip().splitlines() if f.strip()]

    if args.json:
        print(json.dumps({
            "pattern": pattern,
            "target": target,
            "count": len(matches),
            "matches": matches
        }, indent=2))
        return 0

    display_target = target.replace(get_vault_remote_base(), "ZeroDrive: /")
    print(c(f"\n🔍 Found {len(matches)} files matching '{pattern}' in {display_target}:", COLOR_BOLD + COLOR_CYAN))
    print(c("─" * 60, COLOR_DIM))
    for m in matches[:100]:
        print(f"  {m}")
    if len(matches) > 100:
        print(c(f"  ... and {len(matches) - 100} more files (use --json for complete list)", COLOR_DIM))
    print(c("─" * 60, COLOR_DIM) + "\n")
    return 0

def cmd_cp(args):
    """zd cp <src> <dst>: Multi-stream copy supporting file-to-folder and file-to-file"""
    src_type, src_path, src_is_dir_hint = classify_endpoint(args.src)
    dst_type, dst_path, dst_is_dir_hint = classify_endpoint(args.dst)

    # Validate local source exists
    if src_type == EndpointType.LOCAL and not os.path.exists(src_path):
        print(c(f"Error: Local source '{src_path}' does not exist.", COLOR_RED), file=sys.stderr)
        return 1

    # Determine whether destination is a directory
    dst_is_dir = dst_is_dir_hint or (dst_type == EndpointType.LOCAL and os.path.isdir(dst_path))

    # Determine whether source is a single file
    if src_type == EndpointType.LOCAL:
        src_is_file = os.path.isfile(src_path)
    else:
        # Remote source: if it doesn't end with a slash, check if it has a file name
        src_is_file = not src_is_dir_hint

    # Subcommand selection:
    # 1. If destination is explicitly a directory (ends with / or is existing local dir):
    #    'copy' copies the source (file or folder) into that destination directory.
    # 2. If source is a single file and destination is an explicit filename (does not end with /):
    #    'copyto' copies the file to that exact target filename.
    # 3. Otherwise: 'copy'.
    if src_is_file and not dst_is_dir:
        subcmd = "copyto"
    else:
        subcmd = "copy"

    print(c(f"Copying: {src_path} -> {dst_path}", COLOR_CYAN))

    exec_args = [
        subcmd, src_path, dst_path,
        "--transfers=16",
        "--checkers=32",
        "--fast-list",
        "--s3-upload-cutoff=32M",
        "--s3-chunk-size=16M",
        "-P"
    ]
    res = exec_rclone(exec_args, capture_output=False)
    if res.returncode != 0:
        print(c(f"\nError: Transfer failed with exit code {res.returncode}.", COLOR_RED), file=sys.stderr)
        return res.returncode

    print(c("✓ Copy completed successfully.", COLOR_GREEN))
    return 0

def cmd_mv(args):
    """
    zd mv <src> <dst> [--symlink]: High-speed move with safe empty-directory verification
    before any symlink creation.
    """
    src_type, src_path, src_is_dir_hint = classify_endpoint(args.src)
    dst_type, dst_path, dst_is_dir_hint = classify_endpoint(args.dst)

    if src_type == EndpointType.LOCAL and not os.path.exists(src_path):
        print(c(f"Error: Source '{src_path}' does not exist.", COLOR_RED), file=sys.stderr)
        return 1

    # Validate --symlink preconditions upfront before any file transfer
    if args.symlink:
        if src_type != EndpointType.LOCAL or not os.path.isdir(src_path):
            print(c("Error: --symlink requires a local directory source.", COLOR_RED), file=sys.stderr)
            return 2
        vault_base = get_vault_remote_base()
        if dst_type != EndpointType.REMOTE or not dst_path.startswith(vault_base):
            print(c("Error: --symlink only supports destinations inside the ZeroDrive vault.", COLOR_RED), file=sys.stderr)
            return 2

    # Local-to-Local move check
    if src_type == EndpointType.LOCAL and dst_type == EndpointType.LOCAL:
        print(c(f"Moving local path: {src_path} -> {dst_path}", COLOR_CYAN))
        try:
            shutil.move(src_path, dst_path)
            print(c("✓ Moved locally.", COLOR_GREEN))
            return 0
        except Exception as e:
            print(c(f"Error moving locally: {e}", COLOR_RED), file=sys.stderr)
            return 1

    # Determine whether destination is a directory
    dst_is_directory = dst_is_dir_hint or (dst_type == EndpointType.LOCAL and os.path.isdir(dst_path))

    # Determine whether source is a single file
    if src_type == EndpointType.LOCAL:
        src_is_file = os.path.isfile(src_path)
    else:
        src_is_file = not src_is_dir_hint

    if src_is_file and not dst_is_directory:
        subcmd = "moveto"
    else:
        subcmd = "move"

    print(c(f"Moving: {src_path} -> {dst_path}", COLOR_CYAN))

    exec_args = [
        subcmd, src_path, dst_path,
        "--transfers=32",
        "--checkers=64",
        "--fast-list",
        "--s3-upload-cutoff=32M",
        "--s3-chunk-size=16M",
        "-P"
    ]
    res = exec_rclone(exec_args, capture_output=False)
    if res.returncode != 0:
        print(c(f"\nError: Move failed with exit code {res.returncode}. Check destination and remaining source files.", COLOR_RED), file=sys.stderr)
        return res.returncode

    # Safe Symlink Creation (Local source directory move only)
    if args.symlink and src_type == EndpointType.LOCAL and os.path.isdir(src_path):
        # 1. Verify source directory is strictly empty by attempting bottom-up empty directory removal
        remaining_files = []
        for root, dirs, files in os.walk(src_path, topdown=False):
            for f in files:
                remaining_files.append(os.path.join(root, f))
            for d in dirs:
                dir_path = os.path.join(root, d)
                try:
                    os.rmdir(dir_path)
                except OSError:
                    pass

        if remaining_files:
            print(c(
                f"\n⚠️  Incomplete operation: {len(remaining_files)} files remain in '{src_path}'. "
                f"Source directory was NOT removed or replaced with shortcut to protect data.",
                COLOR_YELLOW
            ), file=sys.stderr)
            return 1

        # Try removing the top-level directory (fails if not empty)
        try:
            os.rmdir(src_path)
        except OSError as e:
            print(c(f"\n⚠️  Error: Could not remove empty directory '{src_path}': {e}. Shortcut not created.", COLOR_RED), file=sys.stderr)
            return 1

        # Determine target path inside Finder mount
        rel_dst = dst_path.replace(get_vault_remote_base(), "").strip("/")
        target_mount = os.path.join(MOUNT_DIR, rel_dst)

        try:
            os.symlink(target_mount, src_path)
            print(c(f"✓ Left shortcut: {src_path} -> {target_mount}", COLOR_GREEN))

            # Record in symlinks ledger
            syms = []
            if os.path.exists(SYMLINKS_PATH):
                try:
                    with open(SYMLINKS_PATH, "r") as f:
                        syms = json.load(f)
                except Exception:
                    pass
            syms.append({
                "localPath": src_path,
                "targetMountPath": target_mount,
                "folderName": os.path.basename(src_path),
                "createdTimestamp": time.time()
            })
            with open(SYMLINKS_PATH, "w") as f:
                json.dump(syms, f, indent=2)
        except Exception as e:
            print(c(f"Error creating shortcut or writing ledger: {e}", COLOR_RED), file=sys.stderr)
            return 1

    print(c("✓ Move completed successfully.", COLOR_GREEN))
    return 0

def cmd_share(args):
    """zd share <path> [--hours N]: Generate public pre-signed link with verified output"""
    if args.hours < 1 or args.hours > 168:
        print(c(f"Error: --hours must be between 1 and 168 (1 hour to 7 days), got {args.hours}.", COLOR_RED), file=sys.stderr)
        return 2

    target = resolve_vault_path(args.path)
    res = exec_rclone(["link", target, f"--expire={args.hours}h"])
    if res.returncode != 0:
        print(c(f"Error creating share link for {target}: {res.stderr.strip()}", COLOR_RED), file=sys.stderr)
        return res.returncode

    link = ""
    for line in res.stdout.strip().splitlines():
        if line.startswith("http://") or line.startswith("https://"):
            link = line.strip()
            break

    if not link:
        print(c("Notice: Backend did not return a valid HTTP URL. Output:\n" + res.stdout, COLOR_YELLOW))
        return 1

    if args.json:
        print(json.dumps({"target": target, "expiryHours": args.hours, "url": link}, indent=2))
        return 0

    print(c(f"\n🔗 ZeroDrive Public Link ({args.hours}h expiry):", COLOR_BOLD + COLOR_GREEN))
    print(f"  {link}\n")
    return 0

def cmd_refresh(args):
    """
    zd refresh [dir] [--recursive]: Refresh directory cache via loopback RC API.
    Translates endpoints cleanly through classifier to preserve literal folder names.
    """
    if args.path:
        _, resolved, _ = classify_endpoint(args.path, default_to_vault=True)
        vault_base = get_vault_remote_base()
        if resolved.startswith(vault_base):
            rel = resolved[len(vault_base):].strip("/")
            rc_dir = f"My Drive/{rel}".strip("/") if rel else "My Drive"
        else:
            print(c(f"Error: Refresh path '{args.path}' does not resolve to ZeroDrive vault.", COLOR_RED), file=sys.stderr)
            return 1
    else:
        rc_dir = "My Drive"

    payload = {"dir": rc_dir}
    if args.recursive:
        payload["recursive"] = "true"

    timeout = 60.0 if args.recursive else 8.0
    resp = run_rc_post("vfs/refresh", payload=payload, timeout=timeout)
    if resp is None:
        print(c("Error: ZeroDrive mount daemon is not reachable on 127.0.0.1:55729 (or request timed out).", COLOR_RED), file=sys.stderr)
        return 1

    if "error" in resp:
        print(c(f"Refresh failed: {resp['error']}", COLOR_RED), file=sys.stderr)
        return 1

    result_map = resp.get("result", {})
    status_val = result_map.get(rc_dir, result_map.get("", "Unknown"))

    if status_val == "OK":
        if args.json:
            print(json.dumps({"refreshed": rc_dir, "status": "OK", "recursive": args.recursive}, indent=2))
        else:
            print(c(f"✓ ZeroDrive cache refreshed for '{rc_dir}'. Finder & Terminal are in sync.", COLOR_GREEN))
        return 0
    else:
        print(c(f"Notice: Cache refresh reported '{status_val}' for '{rc_dir}'.", COLOR_YELLOW), file=sys.stderr)
        return 1

def cmd_symlinks(args):
    """zd symlinks [--json]: Audit active folder shortcuts"""
    syms = []
    if os.path.exists(SYMLINKS_PATH):
        try:
            with open(SYMLINKS_PATH, "r") as f:
                syms = json.load(f)
        except Exception:
            pass

    if args.json:
        # Include verified filesystem status in JSON
        for s in syms:
            s["isLink"] = os.path.islink(s.get("localPath", ""))
        print(json.dumps(syms, indent=2))
        return 0

    if not syms:
        print(c("No active ZeroDrive symlink shortcuts found in ledger.", COLOR_DIM))
        return 0

    print(c(f"\n🔗 Active ZeroDrive Shortcuts ({len(syms)}):", COLOR_BOLD + COLOR_CYAN))
    print(c("─" * 60, COLOR_DIM))
    for s in syms:
        local_p = s.get("localPath", "")
        target_p = s.get("targetMountPath", "")
        status = c("✓ Active", COLOR_GREEN) if os.path.islink(local_p) else c("✗ Missing", COLOR_RED)
        print(f"  {s.get('folderName', 'Shortcut'):<22} {status}")
        print(f"    Local:  {c(local_p, COLOR_DIM)}")
        print(f"    Target: {c(target_p, COLOR_DIM)}")
    print(c("─" * 60, COLOR_DIM) + "\n")
    return 0

def cmd_raw(args):
    """zd engine <command...>: Direct pass-through to storage engine with propagated exit code"""
    raw_args = getattr(args, "engine_args", None) or getattr(args, "rclone_args", None) or []
    if not raw_args:
        print("Usage: zd engine <command> [args...]", file=sys.stderr)
        return 1
    res = exec_engine(raw_args, capture_output=False)
    return res.returncode

def cmd_version(args):
    if args.json:
        print(json.dumps({
            "version": VERSION,
            "backend": "Cloudflare R2",
            "vaultPrefix": load_vault_prefix(),
            "mountDir": MOUNT_DIR,
            "engineBin": STORAGE_ENGINE_BIN,
            "configFile": CONFIG_FILE
        }, indent=2))
        return 0
    print(f"ZeroDrive CLI v{VERSION}")
    print(f"Storage Backend: Cloudflare R2 via {load_vault_prefix()}")
    print(f"Local Mount:     {MOUNT_DIR}")
    print(f"Storage Engine:  ZeroDrive Core Engine (Active)")
    print(f"Config:          {CONFIG_FILE}")
    return 0

def cmd_mcp(args):
    mcp_script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zerodrive-mcp")
    if not os.path.exists(mcp_script):
        mcp_script = os.path.expanduser("~/.local/bin/zerodrive-mcp")
    if os.path.exists(mcp_script):
        os.execv(sys.executable, [sys.executable, mcp_script])
    else:
        print("Error: zerodrive-mcp script not found.", file=sys.stderr)
        return 1

def cmd_doctor(args):
    """zd doctor: Full health check of local mount, config, R2 cloud vault, and hosted MCP server"""
    checks = {}
    # 1. Hosted MCP & API Health
    hosted_ok = False
    hosted_info = {}
    try:
        req = urllib.request.Request("https://api.zerodrive.dev/v1/health", headers={"User-Agent": "ZeroDrive-Doctor/1.1"})
        with urllib.request.urlopen(req, timeout=5.0) as resp:
            hosted_info = json.loads(resp.read().decode("utf-8"))
            hosted_ok = hosted_info.get("status") == "healthy"
    except Exception as e:
        hosted_info = {"error": str(e)}
    checks["hostedMcpApi"] = {"ok": hosted_ok, "endpoint": "https://api.zerodrive.dev/mcp", "details": hosted_info}

    # 2. Storage Engine binary & config
    engine_ok = os.path.exists(STORAGE_ENGINE_BIN) and os.path.exists(CONFIG_FILE)
    checks["localEngine"] = {"ok": engine_ok, "engineBin": STORAGE_ENGINE_BIN, "configFile": CONFIG_FILE}

    # 3. Cloud Vault R2 listing check
    res = exec_engine(["lsf", get_vault_remote_base(), "--max-depth", "1"])
    vault_ok = res.returncode == 0
    root_items = [x.strip() for x in res.stdout.splitlines() if x.strip()] if vault_ok else []
    checks["cloudVault"] = {"ok": vault_ok, "remote": get_vault_remote_base(), "rootItemsCount": len(root_items)}

    # 4. Local Finder Mount
    mount_proc = subprocess.run(["mount"], capture_output=True, text=True)
    is_mounted = ".zerodrive-mount" in mount_proc.stdout or "ZeroDrive" in mount_proc.stdout
    checks["finderMount"] = {"ok": is_mounted, "mountDir": MOUNT_DIR}

    if getattr(args, "json", False):
        print(json.dumps({"status": "healthy" if (hosted_ok and vault_ok) else "degraded", "checks": checks}, indent=2))
        return 0 if (hosted_ok and vault_ok) else 1

    print(c("\n🩺 ZeroDrive Doctor & Capability Check", COLOR_BOLD + COLOR_CYAN))
    print(c("═" * 58, COLOR_DIM))
    print(f"  {c('1. Hosted 24/7 MCP:', COLOR_BOLD):<24} {c('✓ Online (https://api.zerodrive.dev/mcp)', COLOR_GREEN) if hosted_ok else c('✗ Unreachable', COLOR_RED)}")
    print(f"  {c('2. OAuth & App Icon:', COLOR_BOLD):<24} {c('✓ Active (https://api.zerodrive.dev/app-icon.png)', COLOR_GREEN) if hosted_ok else c('✗ Check worker', COLOR_YELLOW)}")
    print(f"  {c('3. Cloud R2 Vault:', COLOR_BOLD):<24} {c(f'✓ Connected ({len(root_items)} root collections/files)', COLOR_GREEN) if vault_ok else c('✗ R2 connection error', COLOR_RED)}")
    print(f"  {c('4. Storage Engine:', COLOR_BOLD):<24} {c('✓ Ready', COLOR_GREEN) if engine_ok else c('✗ Missing config file', COLOR_RED)}")
    print(f"  {c('5. Finder Mount:', COLOR_BOLD):<24} {c('✓ Mounted at ~/ZeroDrive/My Drive', COLOR_GREEN) if is_mounted else c('• Unmounted (Cloud & MCP still 100% active)', COLOR_YELLOW)}")
    print(c("─" * 58, COLOR_DIM))
    print(c("  Supported File Types & Agent Tools:", COLOR_BOLD))
    print("    • Text, Markdown & Code  → write_file, read_file, edit_file, grep_vault")
    print("    • Screenshots & PDFs     → upload_binary_file, create_upload_urls, read_file")
    print("    • Videos (.mp4/.mov)     → create_upload_urls (streams up to 5GB) or zd cp")
    print("    • ZIPs & Archives (.zip) → create_upload_urls, upload_binary_file, or zd cp")
    print("    • Agent Skills (_SKILLS) → save_skill (_SKILLS/<verb-noun-name>/SKILL.md)")
    print(c("═" * 58, COLOR_DIM) + "\n")
    return 0 if (hosted_ok and vault_ok) else 1
    print("    • Screenshots & PDFs     → upload_binary_file, create_upload_urls, read_file")
    print("    • Videos (.mp4/.mov)     → create_upload_urls (streams up to 5GB) or zd cp")
    print("    • ZIPs & Archives (.zip) → create_upload_urls, upload_binary_file, or zd cp")
    print("    • Agent Skills (_SKILLS) → save_skill (_SKILLS/<verb-noun-name>/SKILL.md)")
    print(c("═" * 58, COLOR_DIM) + "\n")
    return 0 if (hosted_ok and vault_ok) else 1

# --- ARGUMENT PARSER SETUP ---

def build_parser():
    base_subparser = argparse.ArgumentParser(add_help=False)
    base_subparser.add_argument("--no-color", action="store_true", help="Disable ANSI color output")

    parser = argparse.ArgumentParser(
        prog="zerodrive",
        description="ZeroDrive CLI — Blazing-fast Cloud Drive & AI Agent File Engine",
        epilog="Use 'zerodrive <command> --help' for details on a specific command.",
        parents=[base_subparser]
    )
    subparsers = parser.add_subparsers(dest="command", metavar="<command>")

    # status
    p_status = subparsers.add_parser("status", parents=[base_subparser], help="Show live mount state, SSD free space, VFS cache & sync queues")
    p_status.add_argument("--json", action="store_true", help="Output as structured JSON")

    # ls / list
    p_ls = subparsers.add_parser("ls", aliases=["list"], parents=[base_subparser], help="List directory contents")
    p_ls.add_argument("path", nargs="?", default="", help="Vault folder to list (default: root)")
    p_ls.add_argument("-R", "--recursive", action="store_true", help="List recursively")
    p_ls.add_argument("--json", action="store_true", help="Output as structured JSON")

    # tree
    p_tree = subparsers.add_parser("tree", parents=[base_subparser], help="Visual tree of cloud folder hierarchy")
    p_tree.add_argument("path", nargs="?", default="", help="Vault folder (default: root)")
    p_tree.add_argument("-d", "--depth", type=int, default=2, help="Depth limit (default: 2)")
    p_tree.add_argument("--dirs-only", action="store_true", help="Show directories only")

    # size
    p_size = subparsers.add_parser("size", parents=[base_subparser], help="Query instant metadata size and file count")
    p_size.add_argument("path", nargs="?", default="", help="Vault folder to calculate (default: root)")
    p_size.add_argument("--json", action="store_true", help="Output as structured JSON")

    # cat / read
    p_cat = subparsers.add_parser("cat", aliases=["read"], parents=[base_subparser], help="Stream file contents with line slicing")
    p_cat.add_argument("path", help="Vault file path")
    p_cat.add_argument("--lines", help="Line range to read (e.g. 1-50 or 25)")
    p_cat.add_argument("--head", type=int, help="Read first N lines")
    p_cat.add_argument("--tail", type=int, help="Read last N lines (bounded memory)")
    p_cat.add_argument("--bytes", help="Byte range to read via S3 offset (e.g. 0-1024)")

    # find / search
    p_find = subparsers.add_parser("find", aliases=["search"], parents=[base_subparser], help="Fast server-side wildcard file search")
    p_find.add_argument("pattern", help="Search glob or wildcard (e.g. *.mov)")
    p_find.add_argument("path", nargs="?", default="", help="Vault subfolder to search (default: root)")
    p_find.add_argument("--json", action="store_true", help="Output as structured JSON")

    # cp / copy
    p_cp = subparsers.add_parser("cp", aliases=["copy"], parents=[base_subparser], help="Parallel multi-stream copy")
    p_cp.add_argument("src", help="Source file or folder (local or cloud)")
    p_cp.add_argument("dst", help="Destination file or folder (local or cloud)")

    # mv / move
    p_mv = subparsers.add_parser("mv", aliases=["move"], parents=[base_subparser], help="Parallel move with verified empty-dir symlinking")
    p_mv.add_argument("src", help="Source path (local or cloud)")
    p_mv.add_argument("dst", help="Destination path (local or cloud)")
    p_mv.add_argument("--symlink", action="store_true", help="Replace moved local folder with POSIX symlink")

    # share / link
    p_share = subparsers.add_parser("share", aliases=["link"], parents=[base_subparser], help="Generate public pre-signed Cloudflare link")
    p_share.add_argument("path", help="Vault file to share")
    p_share.add_argument("--hours", type=int, default=24, help="Link expiry in hours (1-168, default: 24)")
    p_share.add_argument("--json", action="store_true", help="Output as structured JSON")

    # refresh / sync
    p_refresh = subparsers.add_parser("refresh", aliases=["sync"], parents=[base_subparser], help="Invalidate loopback VFS cache so Finder updates")
    p_refresh.add_argument("path", nargs="?", default="", help="Specific subfolder to refresh (default: My Drive)")
    p_refresh.add_argument("-R", "--recursive", action="store_true", help="Recursively refresh subfolders")
    p_refresh.add_argument("--json", action="store_true", help="Output as structured JSON")

    # symlinks
    p_syms = subparsers.add_parser("symlinks", parents=[base_subparser], help="List active ZeroDrive local shortcuts")
    p_syms.add_argument("--json", action="store_true", help="Output as structured JSON")

    # doctor / check
    p_doc = subparsers.add_parser("doctor", aliases=["check"], parents=[base_subparser], help="Run full health check on Cloud Vault, Hosted MCP, OAuth, and Local Engine")
    p_doc.add_argument("--json", action="store_true", help="Output as structured JSON")

    # mcp
    p_mcp = subparsers.add_parser("mcp", parents=[base_subparser], help="Start ZeroDrive Model Context Protocol (MCP) server for AI agents")

    # engine / raw
    p_engine = subparsers.add_parser("engine", aliases=["raw"], parents=[base_subparser], help="Direct pass-through to underlying storage engine")
    p_engine.add_argument("engine_args", nargs=argparse.REMAINDER, help="Arguments passed directly to storage engine")

    # version
    p_ver = subparsers.add_parser("version", parents=[base_subparser], help="Show ZeroDrive CLI version and system info")
    p_ver.add_argument("--json", action="store_true", help="Output as structured JSON")

    return parser

def main():
    try:
        parser = build_parser()
        if len(sys.argv) < 2:
            parser.print_help()
            sys.exit(0)

        # Allow --version at root
        if sys.argv[1] in ["-v", "--version"]:
            sys.exit(cmd_version(argparse.Namespace(json=False)))

        args = parser.parse_args()
        if not args.command:
            parser.print_help()
            sys.exit(0)

        dispatch = {
            "status": cmd_status,
            "ls": cmd_ls,
            "list": cmd_ls,
            "tree": cmd_tree,
            "size": cmd_size,
            "cat": cmd_cat,
            "read": cmd_cat,
            "find": cmd_find,
            "search": cmd_find,
            "cp": cmd_cp,
            "copy": cmd_cp,
            "mv": cmd_mv,
            "move": cmd_mv,
            "share": cmd_share,
            "link": cmd_share,
            "refresh": cmd_refresh,
            "sync": cmd_refresh,
            "symlinks": cmd_symlinks,
            "doctor": cmd_doctor,
            "check": cmd_doctor,
            "mcp": cmd_mcp,
            "engine": cmd_raw,
            "raw": cmd_raw,
            "version": cmd_version,
        }

        handler = dispatch.get(args.command)
        if handler:
            ret = handler(args)
            sys.exit(ret if isinstance(ret, int) else 0)
        else:
            parser.print_help()
            sys.exit(2)
    except BrokenPipeError:
        try:
            devnull = os.open(os.devnull, os.O_WRONLY)
            os.dup2(devnull, sys.stdout.fileno())
        except Exception:
            pass
        sys.exit(0)

if __name__ == "__main__":
    main()
